DATABASE_URL=postgresql://postgres:postgres@localhost:5432/siw_barter
ALLOWED_EMAIL_DOMAIN=example.local
NEXTAUTH_SECRET=dev-secret-anything
NEXTAUTH_URL=http://localhost:3000

# 画像保存用のS3_*系は本番のみで使う（M2実装時にVercel側へ追加）。
# 開発中はローカルファイル保存を使うため、ここでは設定不要。

# S3_PUBLIC_BASE_URL: Neon Object Storageバケットの公開URLのベース（本番のみ、Vercel側に追加）。
# 画像アップロード機能(M2)でも使い回す想定の汎用の値。
# /healthページの画像ストレージ確認はこの値 + health-check.jpg で行う。
# 未設定の場合は開発と同じくpublic/health-check.svgで確認するので、ここでは設定不要。
