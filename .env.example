# Neonの接続文字列（開発・本番共通の本番Neon DBを使う。値はPMから安全な方法で受け取る）。
# アプリ実行用（Pooled connection。ホスト名に -pooler が付く）
DATABASE_URL=postgresql://<user>:<password>@<project-id>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require

# drizzle-kit(generate/migrate/studio)用（Direct connection。pooler無し）。
# migrate自体はPMのみが実行するが、db:generate/db:studioは全開発者が使うため全員分の設定が必要。
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<project-id>.<region>.aws.neon.tech/<dbname>?sslmode=require

ALLOWED_EMAIL_DOMAIN=example.local
NEXTAUTH_SECRET=dev-secret-anything
NEXTAUTH_URL=http://localhost:3000

# 画像保存（Neon Object Storage）。開発・本番共通のバケットに直結する（DATABASE_URLと同じ方針）。
# S3_PUBLIC_BASE_URL: バケットの公開URLのベース（読み取り専用・GETのみなので認証情報ではない）。
# /healthページの画像ストレージ確認に使う。
S3_PUBLIC_BASE_URL=https://<branch-id>.storage.c-<n>.<region>.aws.neon.tech/<bucket-name>

# 画像アップロード機能(M2)本体の書き込み用認証情報はまだ無い（Vercel側にも未設定）。
# 実装時に変数名も含めてPMから別途共有する。
